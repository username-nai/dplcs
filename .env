# Database Configuration
# Set these to your Supabase credentials when ready to deploy
# If not set, the app will fall back to local SQLite for development
SUPABASE_DB_NAME=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_password
SUPABASE_DB_HOST=db.your-supabase-project.supabase.co
SUPABASE_DB_PORT=5432

# Django Secret Key
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True
